<script>
  document.addEventListener('DOMContentLoaded', () => {
    const heading = document.querySelector('.hero h1');
    if (!heading) return;

    const badge = document.createElement('span');
    badge.className = 'beta-badge';
    badge.textContent = 'Beta';
    heading.appendChild(badge);
  });
</script>

<style is:global>
  .beta-badge {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.6rem;
    padding: 0.25rem 0.85rem;
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(199, 89%, 68%);
    -webkit-text-fill-color: hsl(199, 89%, 68%);
    background: hsla(199, 89%, 48%, 0.12);
    background-clip: padding-box;
    -webkit-background-clip: padding-box;
    border: 1px solid hsla(199, 89%, 48%, 0.25);
    animation: betaPulse 3s ease-in-out infinite;
  }

  [data-theme="light"] .beta-badge {
    color: hsl(199, 89%, 35%);
    -webkit-text-fill-color: hsl(199, 89%, 35%);
    background: hsla(199, 89%, 48%, 0.08);
    background-clip: padding-box;
    -webkit-background-clip: padding-box;
    border-color: hsla(199, 89%, 48%, 0.2);
  }

  @keyframes betaPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
</style>
